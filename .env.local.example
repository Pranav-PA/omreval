# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Note: no service-role key is needed. Every database and storage call runs as
# the signed-in teacher, so row level security is what keeps accounts separate.

# ---- Python image-processing service ----
# On Vercel the Python functions are deployed alongside the app, so leave this
# blank in production and the app will call its own origin (/api/py/*).
# For local dev run `npm run py:dev` and set this to http://127.0.0.1:8000
PYTHON_API_URL=

# Optional: shared secret so only this app can call the Python endpoints.
# Set the same value in the Vercel project env for the Python functions.
PY_SHARED_SECRET=

# ---- Gemini (independent second reader) ----
# Key from https://aistudio.google.com/apikey
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ - that would ship it to browsers.
# Leave blank to disable the cross-check; the CV reader still works.
GOOGLE_API_KEY=
